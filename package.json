{
  "name": "civicpulse",
  "version": "0.1.0",
  "private": true,
  "description": "Community-powered civic issue reporting and tracking prototype",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:local": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "bash scripts/e2e.sh",
    "e2e:password": "bash scripts/e2e-password.sh",
    "e2e:fallback": "PLAYWRIGHT_CONFIG=playwright.fallback.config.ts bash scripts/e2e.sh",
    "seed": "node scripts/seed.ts",
    "user:create": "node scripts/create-user.ts",
    "retention": "node scripts/retention.ts",
    "ai:usage": "node scripts/ai-usage.ts",
    "db:reset": "node scripts/reset-db.ts",
    "e2e:install": "playwright install chromium",
    "e2e:libs": "bash scripts/setup-browser-libs.sh",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
