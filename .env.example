# Runtime configuration for local development.
# Copy to `.env` (git-ignored) only if you need to override defaults.

# Assistant mode: "mock" (deterministic, no network) or "openai" (requires keys + explicit opt-in).
# Keep "mock" unless an operator has authorized paid API usage.
CIVICPULSE_AI_MODE=mock

# Optional: override where SQLite + private/public media are stored.
# CIVICPULSE_DATA_DIR=.local
# CIVICPULSE_DB_PATH=.local/data/civicpulse.sqlite

# Optional: 32+ char session signing key. If unset, a mode-0600 secret is
# generated once under .local/session-secret (never committed).
# CIVICPULSE_SESSION_SECRET=

# Illustrative demo waiting period for follow-up eligibility (days).
CIVICPULSE_FOLLOWUP_WAITING_DAYS=14

# Extra dev-server origin for HMR when using a preview tunnel (comma separated).
# CIVICPULSE_DEV_ORIGIN=localhost:3000
