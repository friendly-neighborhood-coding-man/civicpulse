# Runtime configuration for local development.
# Copy to `.env` (git-ignored) only if you need to override defaults.

# AI mode: "mock" (offline simulation, no network, no cost) or "openai" (live
# multimodal provider). Keep "mock" unless an operator has authorized paid API
# usage and set a budget. See docs/AI.md.
CIVICPULSE_AI_MODE=mock

# Live provider. Read only when CIVICPULSE_AI_MODE=openai. Never commit a key.
# A live analysis sends one metadata-free 512px JPEG copy to the provider.
# OPENAI_API_KEY=
# CIVICPULSE_AI_MODEL=gpt-5-mini
# CIVICPULSE_AI_BASE_URL=https://api.openai.com/v1
# Reasoning effort is omitted unless set; only set it for a reasoning model.
# CIVICPULSE_AI_REASONING_EFFORT=low
# CIVICPULSE_AI_TIMEOUT_MS=25000
# CIVICPULSE_AI_MAX_OUTPUT_TOKENS=2500

# Spend guards (rolling 24 hours; 0 disables live analysis).
# CIVICPULSE_AI_DAILY_LIMIT=100
# CIVICPULSE_AI_USER_DAILY_LIMIT=10
# CIVICPULSE_AI_PER_REPORT_LIMIT=5

# ESTIMATE inputs for `npm run ai:usage`; not billing data. Re-check the
# provider's pricing page before quoting a cost.
# CIVICPULSE_AI_PRICE_INPUT_PER_MTOK=0.25
# CIVICPULSE_AI_PRICE_OUTPUT_PER_MTOK=2

# Optional: override where SQLite + private/public media are stored.
# CIVICPULSE_DATA_DIR=.local
# CIVICPULSE_DB_PATH=.local/data/civicpulse.sqlite

# Optional: 32+ char session signing key. If unset, a mode-0600 secret is
# generated once under .local/session-secret (never committed).
# CIVICPULSE_SESSION_SECRET=

# Illustrative demo waiting period for follow-up eligibility (days).
CIVICPULSE_FOLLOWUP_WAITING_DAYS=14

# Extra dev-server origin for HMR when using a preview tunnel (comma separated).
# CIVICPULSE_DEV_ORIGIN=localhost:3000
